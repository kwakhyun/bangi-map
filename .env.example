# Local development. Never copy the local demo account or defaults into staging.
DATABASE_USER=fieldtwin
DATABASE_PASSWORD=fieldtwin-local-only
# DATABASE_URL is isolated by scripts/dev.mjs as fieldtwin_bangi.
FIELD_TWIN_ENV=local
FIELD_TWIN_DEMO=true
ALLOWED_ORIGIN=http://127.0.0.1:5173
COOKIE_SECURE=false
# Load a private Seoul key from .runtime/bangi/seoul.env (gitignored).
# SEOUL_API_KEY=
# The provider's documented HTTP transport requires an explicit operator decision.
# SEOUL_BIKE_API_BASE=https://openapi.seoul.go.kr:8088
